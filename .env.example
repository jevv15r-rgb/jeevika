# Copy this file to .env
GEMINI_API_KEY=your_gemini_api_key_here

# Current model defaults are defined in app/config.py.
# You can override them here if your Gemini account exposes another model.
GEMINI_WORKOUT_MODEL=gemini-3.8-flash
GEMINI_TIP_MODEL=gemini-3.8-flash

# Set true if you want to run the UI without a Gemini API key.
DEMO_MODE=false

# Change this before using the admin dashboard.
ADMIN_KEY=change-this-admin-key

DATABASE_URL=sqlite:///./fitbuddy.db
